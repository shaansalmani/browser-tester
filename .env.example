# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: Express + Vite server port (must be 3000 in AI Studio).
PORT=3000

# AGENT_HOST: Local agent interface bind address (strictly 127.0.0.1 only).
AGENT_HOST="127.0.0.1"

# AGENT_PORT: Local agent interface port.
AGENT_PORT=47120

# SQLITE_DB_PATH: Path to SQLite database file.
SQLITE_DB_PATH="./data/browser-tester.db"

# AGENT_AUTH_TOKEN: Server-side shared secret between Express backend and 127.0.0.1 local agent.
# Never expose this via VITE_* variables. Auto-generated in data/.agent-token if omitted.
AGENT_AUTH_TOKEN=""

# ALLOW_LOCAL_DEV_TARGETS: Set to "true" to permit localhost/127.0.0.1 QA targets for local development.
ALLOW_LOCAL_DEV_TARGETS="false"

# CHROME_EXECUTABLE_PATH: Optional explicit path to Google Chrome binary for the local agent.
CHROME_EXECUTABLE_PATH=""

# DASHBOARD_CALLBACK_URL: Backend URL used by the local agent for status reports (defaults to http://127.0.0.1:3000).
DASHBOARD_CALLBACK_URL="http://127.0.0.1:3000"
