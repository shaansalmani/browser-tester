# Local dashboard server. Keep this on loopback for a PC-only installation.
HOST=127.0.0.1
PORT=3000

# Local Chrome Agent. Do not expose this port to the internet.
AGENT_HOST=127.0.0.1
AGENT_PORT=47120

# SQLite database and local agent authentication token.
SQLITE_DB_PATH=./data/browser-tester.db
# Leave blank to generate and store a random token in data/.agent-token.
AGENT_AUTH_TOKEN=

# Set true only when you intentionally need to test a local development site.
ALLOW_LOCAL_DEV_TARGETS=false

# Optional explicit Google Chrome executable path. Usually leave blank.
CHROME_EXECUTABLE_PATH=

# Backend callback used by the local Chrome Agent.
DASHBOARD_CALLBACK_URL=http://127.0.0.1:3000
